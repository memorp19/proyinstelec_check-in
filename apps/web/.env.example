# ─────────────────────────────────────────────────────────────────────────────
# Proyinstelec — variables de entorno
# Local: copia este archivo a apps/web/.env.local y llena los valores.
# Vercel: Project Settings → Environment Variables (mismos nombres).
# ─────────────────────────────────────────────────────────────────────────────

# ── Base de datos (Neon) ─────────────────────────────────────────────────────
# Cadena "pooled" del dashboard de Neon. Debe llevar ?sslmode=require
DATABASE_URL=postgresql://usuario:password@ep-xxxx-pooler.us-east-1.aws.neon.tech/proyinstelec?sslmode=require

# ── Auth.js v5 ───────────────────────────────────────────────────────────────
# Generar con: openssl rand -base64 32
AUTH_SECRET=
# Sólo en local. En Vercel se detecta solo (no la definas).
NEXTAUTH_URL=http://localhost:3000
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID
# URI de redirección autorizada: {origen}/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Dominio de Workspace que se considera personal de planta
GOOGLE_WORKSPACE_DOMAIN=proyinstelec.mx

# ── Google Drive (fotos de campo y carpetas del ERP) ─────────────────────────
# JSON completo de la llave del service account, en una sola línea
DRIVE_SERVICE_ACCOUNT_KEY=
DRIVE_ROOT_FOLDER_ID=

# ── Correo del ERP (Gmail API con delegación de dominio) ─────────────────────
# Si se omite, reutiliza DRIVE_SERVICE_ACCOUNT_KEY
GMAIL_SERVICE_ACCOUNT_KEY=
CORREO_REMITENTE=erp@proyinstelec.mx
# true = no envía correos reales (recomendado en desarrollo)
CORREO_DESHABILITADO=true

# ── Carpetas y plantillas del ERP en Drive ───────────────────────────────────
ERP_COTIZACIONES_FOLDER_ID=
ERP_OT_FOLDER_ID=
ERP_PLANTILLA_DOC_ID=
ERP_PLANTILLA_SHEET_ID=

# ── Odoo (sincronización de jornadas) ────────────────────────────────────────
ODOO_SYNC_ENABLED=false
ODOO_URL=
ODOO_DB=
ODOO_API_KEY=

# ── Modo demo (sin Google ni base) ───────────────────────────────────────────
DEMO_MODE=false

# ── Importador desde los Sheets del sistema anterior ─────────────────────────
IMPORT_SHEET_COTIZACIONES_ID=
IMPORT_SHEET_CLIENTES_ID=
IMPORT_ANIO=2026
