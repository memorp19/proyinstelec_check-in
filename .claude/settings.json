{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm install)",
      "Bash(pnpm test:*)",
      "Bash(pnpm lint)",
      "Bash(pnpm build)",
      "Bash(pnpm db:generate)",
      "Bash(pnpm --filter web:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(git add:*)",
      "Read(./apps/**)",
      "Read(./docs/**)",
      "Read(./scripts/**)"
    ],
    "ask": [
      "Bash(pnpm db:migrate)",
      "Bash(pnpm db:seed)",
      "Bash(git commit:*)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)"
    ],
    "deny": [
      "Read(./apps/web/.env.local)",
      "Read(./.env)",
      "Read(./**/.env.*.local)",
      "Bash(pnpm db:push:*)",
      "Bash(git push:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(rm -rf:*)",
      "Bash(vercel:*)"
    ]
  }
}
